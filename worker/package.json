{
  "name": "tools-social-bot-check-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "npm run check && npm run check:perplexity && node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py'",
    "check": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --outdir .wrangler/build",
    "check:perplexity": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config wrangler.perplexity.jsonc --dry-run --outdir .wrangler/perplexity",
    "deploy:perplexity": "wrangler deploy --config wrangler.perplexity.jsonc",
    "deploy": "wrangler deploy",
    "deploy:ci": "node scripts/deploy.mjs",
    "verify:live": "python3 scripts/verify_published.py",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "miniflare": "5.20261023.0-beta",
    "wrangler": "4.153.0"
  }
}
