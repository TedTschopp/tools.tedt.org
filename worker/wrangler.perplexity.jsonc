{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools-perplexity-view-preview",
  "main": "src/perplexity/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [
    {
      "pattern": "https://tools.tedt.org/share/perplexity-projections/*",
      "zone_name": "tedt.org"
    }
  ]
}
