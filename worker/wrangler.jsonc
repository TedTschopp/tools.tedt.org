{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools-social-bot-check-preview",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [
    {
      "pattern": "https://tools.tedt.org/social-bot-check.html*",
      "zone_name": "tedt.org"
    }
  ],
  "observability": { "enabled": false }
}
