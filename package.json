{
  "name": "tools-tedt-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "build": "npm run prepare:tools && astro build && node scripts/verify-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs tool-src/tests/game-theory/*.test.mjs tool-src/tests/social-bot-check/*.test.mjs tool-src/tests/quick-study-painter/*.test.mjs tool-src/_apps/inside-ai/tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:worker": "npm --prefix worker test"
  },
  "dependencies": {
    "astro": "7.2.8",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "liquidjs": "^10.21.1",
    "marked": "^16.4.1",
    "sass": "^1.93.2"
  },
  "devDependencies": { "@playwright/test": "^1.56.1" }
}
