---
import Layout from '../layouts/Layout.astro';
import CatalogFilters from '../components/CatalogFilters.astro';
import ToolCard from '../components/ToolCard.astro';
import { homepageTools as tools } from '../data/catalog-sections';
import '../styles/landing-artwork.css';
---
<Layout image="https://tedt.org/img/landing/swiss-v1/tools-hero.webp">
  <header class="catalog-heading catalog-heading-illustrated content">
    <div><p class="eyebrow">The Public Workbench</p><h1>Ted’s Tools</h1><p class="lead">Tools for text, code, images, maps, and small experiments.<br />Find a tool. Open it. Work in your browser.</p></div>
    <figure class="catalog-artwork"><picture data-tedt-artwork>
      <source data-tedt-dark type="image/webp" media="(prefers-color-scheme: dark)" srcset="https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero-dark--480w.webp 480w, https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero-dark--768w.webp 768w, https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero-dark--1200w.webp 1200w, https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero-dark--1456w.webp 1456w, https://tedt.org/img/landing/swiss-v1/tools-hero-dark.webp 2171w" sizes="(min-width: 1640px) 826px, (min-width: 1100px) 52vw, calc(100vw - 32px)" />
      <img src="https://tedt.org/img/landing/swiss-v1/tools-hero.webp" srcset="https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero--480w.webp 480w, https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero--768w.webp 768w, https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero--1200w.webp 1200w, https://tedt.org/img/generated/responsive/landing/swiss-v1/tools-hero--1456w.webp 1456w, https://tedt.org/img/landing/swiss-v1/tools-hero.webp 2172w" sizes="(min-width: 1640px) 826px, (min-width: 1100px) 52vw, calc(100vw - 32px)" width="2172" height="724" alt="An open tool case holds a caliper, transforming blocks, and a adjustment dial." fetchpriority="high" decoding="async" />
    </picture></figure>
    <div class="accent-rule"></div>
  </header>
  <script is:inline defer src="https://tedt.org/assets/global-header/v1/artwork.js"></script>
  <section class="content" aria-label="Browse tools">
    <p class="migration-note"><strong>A new home for the collection.</strong> Saved drafts, settings, and API keys from tedt.org do not transfer to this domain. Traveller and separately hosted tools open at their existing addresses.</p>
    <CatalogFilters tools={tools} />
    <div class="catalog-bar"><h2>Tools <span data-count>({tools.length})</span></h2><label class="sort">Sort <select id="sort"><option value="featured">Featured</option><option value="recent">Recently updated</option><option value="title">Alphabetical</option></select></label></div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-results-live></p>
    <div class="tool-grid" data-tool-grid>
      {tools.map((tool, index) => <ToolCard tool={tool} index={index} />)}
    </div>
    <p class="empty-state" data-empty hidden>Nothing matches those filters. Reset one and try again.</p>
  </section>
</Layout>
